          "description": "Provision the site but skip installing WordPress, leaving an empty web root. Optional — defaults to false.",
          "type": "boolean",
        },
        "wait": {
          "description": "Block until provisioning and the WordPress install finish. Optional — defaults to false. Only set this if your MCP client tolerates multi-minute tool calls.",
          "type": "boolean",
        },
        "webServer": {
          "description": "Web server as "<name>-<version>", e.g. "nginx-1.26.1". Optional — see list_service_versions.",
          "type": "string",
        },
